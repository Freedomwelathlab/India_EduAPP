# Copy to .env.local. Never commit real values.
# V1 skeleton runs on in-memory demo data; these are needed once Postgres/Supabase is wired (Nov 2026).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# AI gateway (OmniRoute-compatible / any OpenAI-style endpoint). AI features are OFF unless set.
AI_GATEWAY_URL=
AI_GATEWAY_KEY=
# Video provider (Mux / Cloudflare Stream / Bunny) — decision pending.
VIDEO_PROVIDER=
VIDEO_PROVIDER_TOKEN=
# Feature flags (comma-separated): ai_doubt_suggestions,live_sessions,parent_view
FEATURE_FLAGS=live_sessions,parent_view
# Review-build demo sign-in (fictional accounts). Set both on any deployed build.
DEMO_PASSWORD=
SESSION_SECRET=
